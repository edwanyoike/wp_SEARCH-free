msgstr ""

#: includes/views/tab-docs.php:143
msgid "Developer Hooks"
msgstr ""

#: includes/views/tab-docs.php:144
msgid "These hooks let you customise indexing, ranking, and synonyms without modifying plugin files:"
msgstr ""

#: includes/views/tab-docs.php:147
msgid "Runs just before each product row is written to the index. Use it to add, remove, or transform the data that gets stored."
msgstr ""

#: includes/views/tab-docs.php:156
msgid "Available keys: product_id, title, sku, content, excerpt, price_min, price_max, stock_status, total_sales, sales_30d, image_url, permalink, updated_at. Custom keys are ignored — only the listed columns exist in the index table."
msgstr ""

#: includes/views/tab-docs.php:159
msgid "Tune how results are ranked. Title matches count 5× a description match by default; exact SKU matches always rank first; in-stock and best-selling products get a boost."
msgstr ""

#: includes/views/tab-docs.php:170
msgid "Control which taxonomy term names are searchable. Defaults: categories, tags, brands, and all global attributes (color, material, …)."
msgstr ""

#: includes/views/tab-docs.php:176
msgid "Add synonym groups in code, on top of any groups configured in the Settings tab. Every word in a group matches products containing any other word in the group."
msgstr ""

#: includes/views/tab-docs.php:183
msgid "(action)"
msgstr ""

#: includes/views/tab-docs.php:184
