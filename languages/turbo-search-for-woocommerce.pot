msgstr ""

#: includes/views/tab-docs.php:124
msgid "Heavy load"
msgstr ""

#: includes/views/tab-docs.php:127
msgid "On Windows hosts where sys_getloadavg() is unavailable, the indexer falls back to a fixed batch size of 50."
msgstr ""

#: includes/views/tab-docs.php:128
msgid "Memory Pressure Cap"
msgstr ""

#: includes/views/tab-docs.php:129
msgid "Two independent memory checks can cap the batch size down regardless of CPU load:"
msgstr ""

#: includes/views/tab-docs.php:131
msgid "Relative — current PHP memory usage vs. this worker's own limit: above 70% caps at 25, above 50% caps at 50."
msgstr ""

#: includes/views/tab-docs.php:132
msgid "Absolute — the worker's total memory_limit itself, regardless of current usage: 128MB or below caps at 25, 192MB or below caps at 50, 256MB or below caps at 100."
msgstr ""

#: includes/views/tab-docs.php:134
msgid "The final size is kept between 10 (minimum) and 200 (maximum) before the filter below runs."
msgstr ""

